      "parameterSchemaIds": [],
      "constraints": {
        "movementRelation": "sameAsMain",
        "setOrder": "declared"
      },
      "compatibilities": {
        "generations": [
          "source_fsl_gvt"
        ]
      },
      "block": {
        "id": "fsl_amrap",
