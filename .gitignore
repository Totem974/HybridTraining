# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Static Web generator build/test dependencies and reports
/apps/web_generator/node_modules/
/apps/web_generator/dist/
/apps/web_generator/test-results/
/apps/web_generator/playwright-report/
/apps/web_generator/public/engine/*.deps
/apps/web_generator/public/engine/*.map

# Dart JS compiler sidecars; the public runtime artifact is versioned separately.
/packages/training_engine_web_bridge/web/*.deps
/packages/training_engine_web_bridge/web/*.map

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
