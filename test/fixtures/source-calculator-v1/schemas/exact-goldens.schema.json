{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hybridtraining.local/schemas/source-calculator-v1/exact-goldens.schema.json",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "fixtureSetId",
    "capture",
    "commonInput",
    "scenarioCount",
    "scenarios",
    "corpusSha256"
  ],
  "properties": {
    "$schema": {"const": "schemas/exact-goldens.schema.json"},
    "schemaVersion": {"const": 1},
    "fixtureSetId": {"const": "source-calculator-v1"},
    "capture": {
      "type": "object",
      "required": [
        "method",
        "sourceEntrypoint",
        "sourceArchiveSha256",
        "sourceReportedVersion",
        "networkPolicy",
        "generatedByHybridTraining",
        "copiedSourceAssets"
      ]
    },
    "commonInput": {"type": "object"},
    "scenarioCount": {"type": "integer", "minimum": 1},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "coverage",
          "input",
          "selectedState",
          "output",
          "outputSha256"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "coverage": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "input": {"type": "object"},
          "selectedState": {"type": "object"},
          "output": {
            "type": "object",
            "required": ["weekCount", "weeks"],
            "properties": {
              "weekCount": {"type": "integer", "minimum": 1},
              "weeks": {"type": "array", "minItems": 1}
            }
          },
          "outputSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "oracleAssertions": {
            "type": "object",
            "properties": {
              "bbbChallengeTrainingMaxProgression": {
                "type": "object",
                "required": [
                  "unit",
                  "upperBodyIncrementKg",
                  "lowerBodyIncrementKg",
                  "cycleStartWeeks",
                  "trainingMaxByCycleKg"
                ],
                "properties": {
                  "unit": {"const": "kg"},
                  "upperBodyIncrementKg": {"const": 2.5},
                  "lowerBodyIncrementKg": {"const": 5},
                  "cycleStartWeeks": {
                    "type": "array",
                    "prefixItems": [
                      {"const": 1},
                      {"const": 4},
                      {"const": 8},
                      {"const": 11}
                    ],
                    "minItems": 4,
                    "maxItems": 4
                  },
                  "trainingMaxByCycleKg": {"type": "object"}
                }
              },
              "gvtAlternateSameRatio": {
                "type": "object",
                "required": [
                  "alternateExercise",
                  "useSameRatio",
                  "ratioPercent",
                  "daysPerWeek",
                  "supplementalMovementByMain"
                ],
                "properties": {
                  "alternateExercise": {"const": true},
                  "useSameRatio": {"const": true},
                  "ratioPercent": {"const": 30},
                  "daysPerWeek": {"const": 4},
                  "supplementalMovementByMain": {"type": "object"}
                }
              },
              "bbbChallengeSameLift": {
                "type": "object",
                "required": [
                  "duration",
                  "lessBoring",
                  "supplementalExerciseMode",
                  "daysPerWeek"
                ],
                "properties": {
                  "duration": {"const": "Six Weeks"},
                  "lessBoring": {"const": false},
                  "supplementalExerciseMode": {"const": "sameLift"},
                  "daysPerWeek": {"const": 4}
                }
              }
            }
          }
        }
      }
    },
    "corpusSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
