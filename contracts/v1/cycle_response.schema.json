{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://hybrid.training/contracts/v1/cycle_response.schema.json",
  "allOf": [{ "$ref": "common.schema.json#/$defs/envelope" }, { "type": "object", "required": ["cycle", "warnings", "snapshot"], "properties": {
    "apiVersion": true, "schemaVersion": true, "engineVersion": true, "catalogVersion": true, "catalogHash": true,
    "cycle": { "$ref": "#/$defs/cycle" }, "warnings": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/issue" } }, "snapshot": { "$ref": "snapshot_envelope.schema.json" }
  }, "additionalProperties": false }],
  "$defs": {
    "cycle": { "type": "object", "required": ["schemaVersion", "id", "catalogVersion", "templateId", "variantId", "effectiveTrainingMaxes", "weeks"], "properties": { "schemaVersion": { "const": 1 }, "id": { "type": "string" }, "catalogVersion": { "type": "integer", "minimum": 1 }, "templateId": { "type": "string" }, "variantId": { "type": "string" }, "effectiveTrainingMaxes": { "type": "object", "additionalProperties": { "$ref": "common.schema.json#/$defs/weight" } }, "weeks": { "type": "array", "items": { "$ref": "#/$defs/week" } } }, "additionalProperties": false },
    "week": { "type": "object", "required": ["number", "sessions"], "properties": { "number": { "type": "integer", "minimum": 1 }, "sessions": { "type": "array", "items": { "$ref": "#/$defs/session" } } }, "additionalProperties": false },
    "session": { "type": "object", "required": ["id", "date", "movementId", "blocks"], "properties": { "id": { "type": "string" }, "date": { "type": "string", "format": "date-time" }, "movementId": { "type": "string" }, "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } } }, "additionalProperties": false },
    "block": { "type": "object", "required": ["id", "role", "movementId", "sets"], "properties": { "id": { "type": "string" }, "role": { "type": "string" }, "movementId": { "type": "string" }, "sets": { "type": "array", "items": { "$ref": "#/$defs/set" } } }, "additionalProperties": false },
    "set": { "type": "object", "required": ["index", "repetitions", "percentageBasisPoints", "plannedLoad", "platesPerSide", "execution", "runtimeDecisions", "warning"], "properties": { "index": { "type": "integer", "minimum": 0 }, "repetitions": { "type": "object", "additionalProperties": true }, "percentageBasisPoints": { "type": ["integer", "null"] }, "plannedLoad": { "oneOf": [{ "$ref": "common.schema.json#/$defs/weight" }, { "type": "null" }] }, "platesPerSide": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/weight" } }, "execution": { "type": "object", "additionalProperties": true }, "runtimeDecisions": { "type": "array", "items": { "type": "object", "additionalProperties": true } }, "warning": { "oneOf": [{ "type": "object", "additionalProperties": true }, { "type": "null" }] } }, "additionalProperties": false }
  }
}
