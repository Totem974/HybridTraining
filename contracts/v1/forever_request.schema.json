{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://hybrid.training/contracts/v1/forever_request.schema.json",
  "type": "object", "required": ["apiVersion", "schemaVersion", "macrocycleId", "definitionId", "definitionRevision", "startDate", "initialTrainingMaxes", "slotRequests", "unit", "barProfile"],
  "properties": { "apiVersion": { "const": "v1" }, "schemaVersion": { "const": 1 }, "macrocycleId": { "type": "string", "minLength": 1 }, "definitionId": { "type": "string", "minLength": 1 }, "definitionRevision": { "type": "integer", "minimum": 1 }, "startDate": { "type": "string", "format": "date" }, "initialTrainingMaxes": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "common.schema.json#/$defs/weight" } }, "slotRequests": { "type": "object", "additionalProperties": { "type": "object", "required": ["slotId", "templateId", "variantId", "trainingDays", "sessionOrder", "enabled"], "properties": { "slotId": { "type": "string" }, "templateId": { "type": "string" }, "variantId": { "type": "string" }, "trainingDays": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 7 } }, "sessionOrder": { "type": "array", "items": { "type": "string" } }, "enabled": { "type": "boolean" }, "options": { "type": "object", "additionalProperties": true } }, "additionalProperties": false } }, "unit": { "enum": ["kg", "lb"] }, "barProfile": { "type": "object", "required": ["barWeightCentiUnits", "platesPerSideCentiUnits"], "properties": { "barWeightCentiUnits": { "type": "integer", "minimum": 0 }, "platesPerSideCentiUnits": { "type": "array", "items": { "type": "integer", "exclusiveMinimum": 0 } } }, "additionalProperties": false } },
  "additionalProperties": false
}
