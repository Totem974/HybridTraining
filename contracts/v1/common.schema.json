{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hybrid.training/contracts/v1/common.schema.json",
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["apiVersion", "schemaVersion", "engineVersion", "catalogVersion", "catalogHash"],
      "properties": {
        "apiVersion": { "const": "v1" },
        "schemaVersion": { "const": 1 },
        "engineVersion": { "type": "string", "minLength": 1 },
        "catalogVersion": { "type": "integer", "minimum": 1 },
        "catalogHash": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "weight": {
      "type": "object",
      "required": ["centiUnits", "unit"],
      "properties": {
        "centiUnits": { "type": "integer", "minimum": 0 },
        "unit": { "enum": ["kg", "lb"] }
      },
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "required": ["code", "path", "messageKey", "details", "severity"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "messageKey": { "type": "string", "minLength": 1 },
        "details": { "type": "object", "additionalProperties": true },
        "severity": { "enum": ["error", "warning"] }
      },
      "additionalProperties": false
    },
    "envelope": {
      "type": "object",
      "required": ["apiVersion", "schemaVersion", "engineVersion", "catalogVersion", "catalogHash"],
      "properties": {
        "apiVersion": { "const": "v1" },
        "schemaVersion": { "const": 1 },
        "engineVersion": { "type": "string", "minLength": 1 },
        "catalogVersion": { "type": "integer", "minimum": 1 },
        "catalogHash": { "type": "string", "minLength": 1 }
      }
    }
  }
}
